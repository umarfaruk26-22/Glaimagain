# GLAIMAGAIN Environment Configuration
# Copy this file to .env or configure in config/config.php

APP_NAME=GLAIMAGAIN
APP_TAGLINE="FASHION BEYOND TODAY"
APP_ENV=development
APP_DEBUG=true

# Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=glaimagain_db
DB_USER=root
DB_PASS=

# Razorpay API Credentials (Test Mode)
# Replace with your actual Razorpay Test Key and Secret from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_CURRENCY=INR

# Shipping & Store Defaults
DEFAULT_SHIPPING_FEE=99.00
FREE_SHIPPING_THRESHOLD=1999.00
CURRENCY_SYMBOL=₹
